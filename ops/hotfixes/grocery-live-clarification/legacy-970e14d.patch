+def _live_grocery_clarification_response(payload: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "status": "needs_input",
+        "dry_run": False,
+        "write_committed": False,
+        "request_id": payload["request_id"],
+        "domain": "aura.grocery_capture",
+        "display_message": "No identifiqué el artículo · no cambié nada",
+        "question": "¿Qué artículo quieres agregar al mercado?",
+        "plan": {
+            "side_effects": [],
+            "would_write": False,
+            "notes": "Live grocery clarification; no external write was attempted.",
+        },
+        "gates_missing": [],
+    }
+
+
+def correct_legacy_grocery_clarification(
+    payload: dict[str, Any], cached: dict[str, Any], ledger_status: str
+) -> dict[str, Any]:
+    """Present only the proven old no-write clarification; never edit its ledger."""
+    if not isinstance(payload, dict) or not isinstance(cached, dict):
+        return cached
+    route = payload.get("route")
+    context = payload.get("context")
+    if not isinstance(route, dict) or not isinstance(context, dict):
+        return cached
+    if (route.get("agent"), route.get("intent"), route.get("domain")) != (
+        "aura", "grocery", "aura.grocery_capture"
+    ):
+        return cached
+    if not (
+        context.get("dry_run") is False
+        and context.get("allow_write") is True
+        and context.get("allow_firefly_write") is False
+        and all(context.get(key, False) is False for key in (
+            "user_confirmation", "user_cancellation", "requires_confirmation"
+        ))
+        and context.get("confirmation_token") is None
+        and context.get("operation_id") is None
+    ):
+        return cached
+    request_id = payload.get("request_id")
+    if not isinstance(request_id, str) or not request_id.strip():
+        return cached
+    if set(cached) != {
+        "status", "dry_run", "write_committed", "request_id", "domain",
+        "display_message", "question", "plan", "gates_missing"
+    }:
+        return cached
+    plan = cached.get("plan")
+    if not isinstance(plan, dict) or set(plan) != {"side_effects", "would_write", "notes"}:
+        return cached
+    if not (
+        ledger_status == "needs_confirmation"
+        and cached.get("status") == "needs_confirmation"
+        and cached.get("request_id") == request_id
+        and cached.get("domain") == "aura.grocery_capture"
+        and cached.get("dry_run") is True
+        and cached.get("write_committed") is False
+        and cached.get("display_message") == "No parece un artículo de mercado · no cambié nada"
+        and cached.get("question") == "¿Qué artículo quieres agregar o marcar como comprado?"
+        and cached.get("gates_missing") == ["server domain allowlist", "external write adapter"]
+        and plan.get("would_write") is False
+        and plan.get("side_effects") == ["notion.official_grocery_list.plan_only"]
+        and plan.get("notes") == "Would update official grocery list; unchecked means missing."
+    ):
+        return cached
+    return _live_grocery_clarification_response(payload)
+
