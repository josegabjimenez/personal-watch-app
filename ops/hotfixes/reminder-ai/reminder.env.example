# Review-only: no new domain or spending is enabled by this example.
# Preserve the actual loaded unit/argv and grocery-only configuration.
MOBILE_CAPTURE_REMINDER_PROVIDER=openai
MOBILE_CAPTURE_REMINDER_MODEL=gpt-6-luna
MOBILE_CAPTURE_REMINDER_AI_TIMEOUT=8
MOBILE_CAPTURE_REMINDER_TODOIST_TIMEOUT=5
# Reuse the already approved EXISTING app key file; do not copy its value.
# MOBILE_CAPTURE_REMINDER_OPENAI_KEY_FILE=/private/service/existing-app-openai.key
# Dedicated app OAuth bundle, never the Codex connector token.
# MOBILE_CAPTURE_REMINDER_TODOIST_CREDENTIALS_FILE=/private/service/todoist-reminder-oauth.json
# Pin the existing agreed Inbox metadata after authorized account enrollment.
# MOBILE_CAPTURE_REMINDER_TODOIST_INBOX_ID=<existing-inbox-id>
# Independent durable budget and witness; grocery USD2 state stays untouched.
# MOBILE_CAPTURE_REMINDER_BUDGET_PATH=/private/service/state/reminder-ai-budget.sqlite3
MOBILE_CAPTURE_REMINDER_MONTHLY_LIMIT_USD=0
# Do not modify MOBILE_CAPTURE_WRITE_ENABLED or MOBILE_CAPTURE_WRITE_DOMAINS
# before the separately reviewed and authorized reminder rollout.
